includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src

    level: 8

    tmpDir: build/phpstan

    ignoreErrors:
        -
            identifier: trait.unused
            path: src/AuditLog/Concerns/HasTamperEvidentAuditLog.php
            # This trait exists to be `use`d by a *consuming* application's
            # own Eloquent models (see README.md) — nothing under `src`
            # itself uses it, since this package ships the trait, not a
            # model to apply it to. PHPStan can only see that it's unused
            # within the analysed `src` path, not that it has real
            # consumers outside the package; the trait's own test coverage
            # (tests/Feature/AuditLog/AuditLogHashChainTest.php) applies it
            # to a model precisely to prove it works.
        -
            identifier: trait.unused
            path: src/Consent/Concerns/HasConsent.php
            # Same reasoning as HasTamperEvidentAuditLog above: this trait
            # is meant to be `use`d by a consuming application's own
            # ConsentSubject model (see README.md), not by anything under
            # `src` itself. tests/Fixtures/Person.php and
            # tests/Fixtures/TestUser.php apply it to prove it works.
